    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "url = \"https://raw.githubusercontent.com/mwaskom/seaborn-data/master/tips.csv\"\n",
    "df = pd.read_csv(url)\n",
    "print(df.head())\n",
    "df.groupby(\"day\")[\"total_bill\"].mean().plot(kind=\"bar\")\n",
    "plt.show()"
   ]
